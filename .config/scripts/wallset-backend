#!/bin/bash

# check if the user provided an argument
if [ "$#" -ne 1 ]; then
  echo "Usage: $0 <path_to_image>"
  exit 1
fi

IMAGE="$1"

# Set wallpaper
awww img "$IMAGE" --transition-type="fade" --transition-step=1 --transition-fps="360" # Set fps to your monitors refresh rate

# cache wallpaper for hyprlock and rofi
CACHE="$HOME/.cache/wallpaper/currentWallpaper.png"
mkdir -p "$HOME/.cache/wallpaper"

cp "$1" "$CACHE"

# Use Matugen to generate Material You colors
matugen --source-color-index 0 image "$IMAGE"
