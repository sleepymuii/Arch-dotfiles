//
// windowrules & workspaces 
//

workspace "1" {
}

workspace "2" {
}

workspace "3"{
}

window-rule {
  match app-id="vesktop"
  open-on-workspace "1"
}

window-rule {
  match app-id="Spotify"
  open-on-workspace "1"
}

window-rule {
    match app-id="vivaldi-stable"
    open-on-workspace "2"
    open-maximized true
}

window-rule {
  match app-id="steam"
  open-on-workspace "3"
}

window-rule {
    match app-id=r#"vivaldi$"# title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
  match is-floating=true

  default-column-width { fixed 1000; }
  default-window-height { fixed 1000; }
}

window-rule {
 match app-id="nwg-look"
 open-floating true
  default-column-width { fixed 1000; }
  default-window-height { fixed 800; }
}

window-rule {
  match app-id="org.pulseaudio.pavucontrol"
  open-floating true
  default-column-width { fixed 1000; }
  default-window-height { fixed 1000; }
}

layer-rule {
    match namespace="awww-daemon"
    place-within-backdrop true
}

layer-rule {
  match namespace="awww"
}

