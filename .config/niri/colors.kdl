layout {
    focus-ring {
        active-color "#cebdfe"
        inactive-color "#938f99"
        urgent-color   "#ffb4ab"
    }

    border {
	off
        active-color   "#cebdfe"
        inactive-color "#938f99"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#cebdfe"
        inactive-color "#938f99"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#cebdfe80"
    }
}
